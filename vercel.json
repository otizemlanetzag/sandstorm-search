{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/search", "destination": "/api/index?route=search" },
    { "source": "/api/status", "destination": "/api/index?route=status" },
    { "source": "/api/dictionary", "destination": "/api/index?route=dictionary" },
    { "source": "/api/scan", "destination": "/api/index?route=scan" },
    { "source": "/api/account/:path*", "destination": "/api/index?route=account/:path*" }
  ]
}
